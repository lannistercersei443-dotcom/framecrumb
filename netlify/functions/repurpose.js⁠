import fetch from 'node-fetch';

exports.handler = async function(event, context) {
  if (event.httpMethod !== 'POST') {
    return { statusCode: 405, body: 'Method Not Allowed' };
  }

  try {
    const apiKey = process.env.OPENAI_API_KEY;
    if (!apiKey) {
      return { statusCode: 500, body: JSON.stringify({ error: 'OpenAI API key not configured on server.' }) };
    }

    const body = JSON.parse(event.body);
    const text = body.text;
    const tone = body.tone || 'professional';

    const prompt = `You are an expert AI content repurposing assistant. Given the source text, generate exactly 10 high-performing social media assets in JSON format with three keys: 
    - "scripts": array of 3 short video hooks/scripts.
    - "xPosts": array of 4 Twitter/X posts.
    - "linkedinPosts": array of 3 LinkedIn posts.
    Tone: ${tone}. 
    Source text: """${text}"""`;

    const response = await fetch('https://api.openai.com/v1/chat/completions', {
      method: 'POST',
      headers: {
        'Authorization': `Bearer ${apiKey}`,
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({
        model: 'gpt-4o-mini',
        messages: [{ role: 'user', content: prompt }],
        response_format: { type: 'json_object' }
      })
    });

    const data = await response.json();
    if (!response.ok) {
      return { statusCode: response.status, body: JSON.stringify({ error: data.error?.message || 'AI generation failed' }) };
    }

    const parsedContent = JSON.parse(data.choices[0].message.content);

    return {
      statusCode: 200,
      body: JSON.stringify(parsedContent)
    };
  } catch (error) {
    return { statusCode: 500, body: JSON.stringify({ error: error.message }) };
  }
};
